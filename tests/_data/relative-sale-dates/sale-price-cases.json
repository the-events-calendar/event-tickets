{
	"cases": [
		{
			"name": "2 weeks to 1 week before start",
			"rule": {
				"start": { "mode": "relative", "value": 2, "unit": 604800 },
				"end": { "mode": "relative", "value": 1, "unit": 604800 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "2027-06-10", "end": "2027-06-17" }
		},
		{
			"name": "days before a start just after midnight, across the spring change",
			"rule": {
				"start": { "mode": "relative", "value": 3, "unit": 86400 },
				"end": { "mode": "relative", "value": 1, "unit": 86400 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-03-16 00:30:00",
			"event_end": "2027-03-16 02:30:00",
			"expected": { "start": "2027-03-13", "end": "2027-03-15" }
		},
		{
			"name": "days before a start just before midnight, across the autumn change",
			"rule": {
				"start": { "mode": "relative", "value": 2, "unit": 86400 },
				"end": { "mode": "relative", "value": 1, "unit": 86400 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-11-08 23:30:00",
			"event_end": "2027-11-09 01:30:00",
			"expected": { "start": "2027-11-06", "end": "2027-11-07" }
		},
		{
			"name": "weeks before a start just after midnight, across the spring change east of UTC",
			"rule": {
				"start": { "mode": "relative", "value": 2, "unit": 604800 },
				"end": { "mode": "relative", "value": 1, "unit": 604800 }
			},
			"timezone": "Europe/Berlin",
			"event_start": "2027-04-05 00:15:00",
			"event_end": "2027-04-05 02:15:00",
			"expected": { "start": "2027-03-22", "end": "2027-03-29" }
		},
		{
			"name": "30 weeks to 1 day before start",
			"rule": {
				"start": { "mode": "relative", "value": 30, "unit": 604800 },
				"end": { "mode": "relative", "value": 1, "unit": 86400 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "2026-11-26", "end": "2027-06-23" }
		},
		{
			"name": "now to 1 week before start",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": 1, "unit": 604800 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "", "end": "2027-06-17" }
		},
		{
			"name": "now to a specific end",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "specific" }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "", "end": null }
		},
		{
			"name": "30 days before start to a specific end",
			"rule": {
				"start": { "mode": "relative", "value": 30, "unit": 86400 },
				"end": { "mode": "specific" }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "2027-05-25", "end": null }
		},
		{
			"name": "a specific start to 3 days before start",
			"rule": {
				"start": { "mode": "specific" },
				"end": { "mode": "relative", "value": 3, "unit": 86400 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": null, "end": "2027-06-21" }
		},
		{
			"name": "a specific start and a specific end",
			"rule": {
				"start": { "mode": "specific" },
				"end": { "mode": "specific" }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": null, "end": null }
		},
		{
			"name": "an end before the start still resolves, the save rejects it",
			"rule": {
				"start": { "mode": "relative", "value": 1, "unit": 604800 },
				"end": { "mode": "relative", "value": 2, "unit": 604800 }
			},
			"timezone": "America/New_York",
			"event_start": "2027-06-24 19:00:00",
			"event_end": "2027-06-24 22:00:00",
			"expected": { "start": "2027-06-17", "end": "2027-06-10" }
		}
	],
	"invalid_rules": [
		{
			"name": "value 0",
			"rule": {
				"start": { "mode": "relative", "value": 0, "unit": 86400 },
				"end": { "mode": "specific" }
			},
			"reason": "The value must be an integer from 1 to 30."
		},
		{
			"name": "value 31",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": 31, "unit": 86400 }
			},
			"reason": "The value must be an integer from 1 to 30."
		},
		{
			"name": "non-integer value",
			"rule": {
				"start": { "mode": "relative", "value": 2.5, "unit": 86400 },
				"end": { "mode": "specific" }
			},
			"reason": "The value must be an integer from 1 to 30."
		},
		{
			"name": "value sent as a string",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": "2", "unit": 86400 }
			},
			"reason": "The value must be an integer from 1 to 30."
		},
		{
			"name": "12 hours",
			"rule": {
				"start": { "mode": "relative", "value": 12, "unit": 3600 },
				"end": { "mode": "specific" }
			},
			"reason": "The unit must be days or weeks."
		},
		{
			"name": "minutes",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": 30, "unit": 60 }
			},
			"reason": "The unit must be days or weeks."
		},
		{
			"name": "relative end without a unit",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": 2 }
			},
			"reason": "The unit must be days or weeks."
		},
		{
			"name": "a stored anchor",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "relative", "value": 1, "unit": 604800, "anchor": "start" }
			},
			"reason": "A sale price is always counted from the event start, so it takes no anchor."
		},
		{
			"name": "a default end",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "default" }
			},
			"reason": "The mode must be now, relative or specific."
		},
		{
			"name": "a default start",
			"rule": {
				"start": { "mode": "default" },
				"end": { "mode": "specific" }
			},
			"reason": "The mode must be now, relative or specific."
		},
		{
			"name": "a now end",
			"rule": {
				"start": { "mode": "now" },
				"end": { "mode": "now" }
			},
			"reason": "The end must be relative or specific."
		},
		{
			"name": "unknown mode",
			"rule": {
				"start": { "mode": "after" },
				"end": { "mode": "specific" }
			},
			"reason": "The mode must be now, relative or specific."
		},
		{
			"name": "missing end",
			"rule": {
				"start": { "mode": "now" }
			},
			"reason": "Both start and end are required."
		},
		{
			"name": "end as a string",
			"rule": {
				"start": { "mode": "now" },
				"end": "specific"
			},
			"reason": "Both start and end are required."
		}
	]
}
