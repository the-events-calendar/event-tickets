{
    "allOf": [
        {
            "$ref": "#/components/schemas/TEC_Post_Entity_Request_Body"
        },
        {
            "title": "Ticket Request Body",
            "description": "The request body for the ticket endpoint",
            "type": "object",
            "properties": {
                "event": {
                    "description": "The ID of the post this ticket is associated with. Normally an event-like post.",
                    "type": "integer",
                    "example": 123
                },
                "price": {
                    "description": "The price of the ticket",
                    "type": "number",
                    "example": 25.05
                },
                "sale_price": {
                    "description": "The sale price of the ticket",
                    "type": "number",
                    "example": 20.05
                },
                "sale_price_start_date": {
                    "description": "The start date for the sale price",
                    "type": "string",
                    "format": "date",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "example": "2025-06-01"
                },
                "sale_price_end_date": {
                    "description": "The end date for the sale price",
                    "type": "string",
                    "format": "date",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "example": "2025-06-30"
                },
                "capacity": {
                    "description": "The capacity of the ticket",
                    "type": "integer",
                    "example": 100
                },
                "event_capacity": {
                    "description": "The capacity of the event",
                    "type": "integer",
                    "example": 140
                },
                "stock": {
                    "description": "The stock quantity available",
                    "type": "integer",
                    "example": 100
                },
                "show_description": {
                    "description": "Whether to show the ticket description",
                    "type": "boolean",
                    "example": true
                },
                "stock_mode": {
                    "description": "The stock mode of the ticket",
                    "type": "string",
                    "default": "own",
                    "enum": [
                        "own",
                        "capped",
                        "global",
                        "unlimited"
                    ],
                    "example": "own"
                },
                "type": {
                    "description": "The type of ticket",
                    "type": "string",
                    "example": "default"
                },
                "start_date": {
                    "description": "The start sale date of the ticket",
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
                    "example": "2025-05-01 00:00:00"
                },
                "end_date": {
                    "description": "The end sale date of the ticket",
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
                    "example": "2025-09-04 23:59:59"
                },
                "sku": {
                    "description": "The SKU of the ticket",
                    "type": "string",
                    "example": "TICKET-123"
                }
            }
        },
        {
            "type": "object",
            "properties": {
                "relative_sale_dates": {
                    "description": "The sales window relative to the event, or null when the ticket has fixed sale dates. Sending null removes the rule.",
                    "nullable": true,
                    "type": "object",
                    "properties": {
                        "start": {
                            "description": "When sales start.",
                            "type": "object",
                            "properties": {
                                "mode": {
                                    "description": "How the end is set: `default` (sales open at once, or close when the event starts), `relative` (before the event) or `specific` (the date sent with the ticket).",
                                    "type": "string",
                                    "enum": [
                                        "default",
                                        "relative",
                                        "specific"
                                    ],
                                    "example": "relative"
                                },
                                "value": {
                                    "description": "For a relative end, the number of units before the anchor, from 1 to 60.",
                                    "type": "integer",
                                    "maximum": 60,
                                    "minimum": 1,
                                    "example": 2
                                },
                                "unit": {
                                    "description": "For a relative end, the unit in seconds: 60 (minutes), 3600 (hours), 86400 (days) or 604800 (weeks).",
                                    "type": "integer",
                                    "example": 604800
                                },
                                "anchor": {
                                    "description": "For a relative end, the event date it is counted from.",
                                    "type": "string",
                                    "enum": [
                                        "start",
                                        "end"
                                    ],
                                    "example": "start"
                                }
                            }
                        },
                        "end": {
                            "description": "When sales end.",
                            "type": "object",
                            "properties": {
                                "mode": {
                                    "description": "How the end is set: `default` (sales open at once, or close when the event starts), `relative` (before the event) or `specific` (the date sent with the ticket).",
                                    "type": "string",
                                    "enum": [
                                        "default",
                                        "relative",
                                        "specific"
                                    ],
                                    "example": "relative"
                                },
                                "value": {
                                    "description": "For a relative end, the number of units before the anchor, from 1 to 60.",
                                    "type": "integer",
                                    "maximum": 60,
                                    "minimum": 1,
                                    "example": 2
                                },
                                "unit": {
                                    "description": "For a relative end, the unit in seconds: 60 (minutes), 3600 (hours), 86400 (days) or 604800 (weeks).",
                                    "type": "integer",
                                    "example": 604800
                                },
                                "anchor": {
                                    "description": "For a relative end, the event date it is counted from.",
                                    "type": "string",
                                    "enum": [
                                        "start",
                                        "end"
                                    ],
                                    "example": "start"
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}