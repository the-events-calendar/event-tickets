.tribe-editor__ticket {
	border-bottom: 1px solid var(--tec-color-border-secondary);
	font-family: "Helvetica Neue", Helvetica, -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif;
	padding: var(--tec-spacer-2) 0 var(--tec-spacer-3) 0;
	position: relative;

	&--selected {
		border: 1px solid #b1b5b8;
		padding: 0;
	}
}

.components-spinner {

	.tribe-editor__ticket & {
		float: none;
		left: 50%;
		margin: 0;
		opacity: 0.8;
		position: absolute;
		top: 50%;
		transform: translate(-50%, -50%);
	}
}

.tribe-editor__ticket__deferred-status {
	align-items: center;
	display: flex;
	flex-wrap: wrap;
	font-size: 12px;
	gap: var(--tec-spacer-1);
	padding: var(--tec-spacer-1) var(--tec-spacer-3) 0;
}

.tribe-editor__ticket__deferred-badge {
	background: #fcf9e8;
	border-radius: 10px;
	color: #614200;
	font-weight: 600;
	line-height: 18px;
	padding: 0 8px;
}

.tribe-editor__ticket__deferred-error {
	color: #8a2424;
}

.tribe-editor__ticket--save-error {
	border-left: 3px solid #d63638;
}
