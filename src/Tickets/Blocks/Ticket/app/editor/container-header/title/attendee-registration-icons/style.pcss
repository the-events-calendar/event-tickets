.tribe-editor__title__attendee-registration-icons {
	align-items: center;
	display: flex;

	> span {
		height: 23px;
		width: 24px;
	}

	svg {
		padding-left: var(--tec-spacer-1);
	}

	/* The size of the classic tickets list clock, so the sale window icon reads at the size of the ticket title. */
	.tribe-editor__title__sale-window-icon {
		height: 20px;
		width: 20px;
	}
}
