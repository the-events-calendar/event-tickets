/*
 * Every rule starts at `.editor-styles-wrapper`: the block editor copies
 * a stylesheet into its canvas iframe only when one of its selectors
 * names that class or `.wp-block`.
 */
.editor-styles-wrapper .tec-tickets-relative-sale-dates {
	display: flex;
	flex-wrap: wrap;
	gap: 8px 16px;
}

.editor-styles-wrapper .tec-tickets-relative-sale-dates__end {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.editor-styles-wrapper .tec-tickets-relative-sale-dates__relative {
	align-items: center;
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

.editor-styles-wrapper .tec-tickets-relative-sale-dates__helper {
	color: #757575;
	flex-basis: 100%;
	font-size: 12px;
	margin: 0;
}

/* The select draws no border: the control's backdrop, its sibling, does. */
.editor-styles-wrapper
.tec-tickets-relative-sale-dates
select[aria-invalid="true"] ~ .components-input-control__backdrop {
	border-color: #cc1818;
}

.editor-styles-wrapper .tec-tickets-relative-sale-dates__error {
	color: #cc1818;
}

/* Each end shows only its own half of the picker it is handed. */
.editor-styles-wrapper
.tec-tickets-relative-sale-dates__picker--start
.tribe-editor__date-time-range-picker__end,
.editor-styles-wrapper
.tec-tickets-relative-sale-dates__picker--end
.tribe-editor__date-time-range-picker__start,
.editor-styles-wrapper
.tec-tickets-relative-sale-dates__picker--end
.tribe-editor__date-time-range-picker__separator--time-range {
	display: none;
}
