/**
 * The head of a recurring event's tickets, and their Sold column, in the classic editor's tickets panel.
 *
 * @since TBD
 */
.tec-tickets-recurring-header {
	align-items: center;
	display: flex;
	flex: 1 1 100%;
	gap: 12px;
	justify-content: space-between;
	margin: 0 0 16px;
}

.tec-tickets-recurring-header__title {
	font-size: 20px;
	font-weight: 400;
	line-height: 1.4;
	margin: 0;
}

.tec-tickets-recurring-header__description {
	color: #646970;
	font-size: 13px;
	line-height: 1.5;
	margin: 0;
}

.tec-tickets-recurring-header__actions {
	display: flex;
	flex-shrink: 0;
	gap: 8px;
}

.tec-tickets-recurring-header__by-date.button {
	align-items: center;
	display: inline-flex;
	gap: 4px;

	.dashicons {
		font-size: 18px;
		height: 18px;
		width: 18px;
	}
}

.tribe_ticket_list_table .ticket_sold {
	width: 115px;
}
